{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vue-ensemble",
      "destination": "/index.html"
    },
    {
      "source": "/le-salon",
      "destination": "/index.html"
    },
    {
      "source": "/exposants",
      "destination": "/index.html"
    },
    {
      "source": "/partenaires",
      "destination": "/index.html"
    },
    {
      "source": "/contacts",
      "destination": "/index.html"
    },
    {
      "source": "/taches-planning",
      "destination": "/index.html"
    },
    {
      "source": "/planning-animations",
      "destination": "/index.html"
    },
    {
      "source": "/communication",
      "destination": "/index.html"
    },
    {
      "source": "/deco-budget",
      "destination": "/index.html"
    },
    {
      "source": "/idees",
      "destination": "/index.html"
    },
    {
      "source": "/assets",
      "destination": "/index.html"
    },
    {
      "source": "/previsionnel",
      "destination": "/index.html"
    },
    {
      "source": "/factures-devis",
      "destination": "/index.html"
    },
    {
      "source": "/bilan",
      "destination": "/index.html"
    },
    {
      "source": "/feedback",
      "destination": "/index.html"
    },
    {
      "source": "/reglages",
      "destination": "/index.html"
    },
    {
      "source": "/mes-taches",
      "destination": "/index.html"
    },
    {
      "source": "/mur-echange",
      "destination": "/index.html"
    },
    {
      "source": "/vip",
      "destination": "/index.html"
    },
    {
      "source": "/sac-vip",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/feedback-analysis.js": {
      "maxDuration": 60
    }
  }
}
